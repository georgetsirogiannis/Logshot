<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	<AssemblyName>Logshot.Desktop</AssemblyName>
	  <ApplicationIcon>..\Logshot\Assets\logshot-icon.ico</ApplicationIcon>

	  <!-- Branding Metadata -->
	  <Title>Logshot</Title>
	  <Product>Logshot Desktop</Product>
	  <Authors>George Tsirogiannis</Authors>
	  <Company>George Tsirogiannis</Company>
	  <Copyright>Copyright © 2026 George Tsirogiannis</Copyright>
	  <Description>Daily shot-reporting application for script supervisors.</Description>
	  
  </PropertyGroup>

  <PropertyGroup>
	<ApplicationManifest>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Target Name="GenerateVersionedApplicationManifest" BeforeTargets="PrepareForBuild">
	<MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)" />
	<Copy SourceFiles="$(MSBuildProjectDirectory)\app.manifest" DestinationFiles="$(ApplicationManifest)" />
	<XmlPoke XmlInputPath="$(ApplicationManifest)" Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version" Value="$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value).0" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Supabase" />
	  <PackageReference Include="QuestPDF" />	  
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logshot\Logshot.csproj" />
  </ItemGroup>
</Project>
