<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="140"
             x:Class="Logshot.Views.TakeCardView"
             x:DataType="vm:TakeViewModel">
  <Grid ClipToBounds="True">
    
    <!-- Quick Action Drawer (Swipe Right) -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{StaticResource HeaderBackground}" Spacing="0">
      <Button Name="FsButton" Content="FS" Width="60" HorizontalContentAlignment="Center" Command="{Binding IncrementFalseStartsCommand}"/>
      <Button Name="LsButton" Content="LS" Width="60" HorizontalContentAlignment="Center" Command="{Binding ToggleLongStartCommand}"/>
      <Button Name="VoidButton" Content="AKYRO" Width="70" HorizontalContentAlignment="Center" Background="{StaticResource FailRed}" Command="{Binding ToggleVoidPrimaryCameraCommand}"/>
    </StackPanel>
    
  <!-- Main Card Surface -->
    <Border Name="CardSurface" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,0,1" Padding="12,8" MinHeight="{Binding RowMinHeight}" IsHitTestVisible="{Binding $parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized, Converter={x:Static BoolConverters.Not}}" PointerPressed="Card_PointerPressed" PointerMoved="Card_PointerMoved" PointerReleased="Card_PointerReleased">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
        
        <!-- ROW 0: SHOT & TAKE -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
            <TextBlock Text="SHOT" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding DisplayShot}" Width="50" FontWeight="Bold" FontSize="15" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsSoundOnlyRow}"/>
            <TextBlock Text="TAKE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            
            <Grid Width="26" Height="26" VerticalAlignment="Center">
              <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{StaticResource ActionAccent}" IsVisible="{Binding ShowCircledActive}"/>
              <TextBox Name="TakeNumberBox" Text="{Binding DisplayTakeNumber}" Width="26" Height="26" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource ActionAccent}" IsReadOnly="{Binding IsSoundOnlyRow}">
                <TextBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Mark Circled" Command="{Binding MarkCircledCommand}"/>
                    <MenuItem Header="Mark Failed" Command="{Binding MarkFailedCommand}"/>
                    <MenuItem Header="Toggle Pickup (PU)" Command="{Binding TogglePickupCommand}"/>
                  </ContextMenu>
                </TextBox.ContextMenu>
              </TextBox>
              
              <!-- CLEAR RED X OVER TAKE NUMBER -->
              <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowFailedActive}"/>
            </Grid>
            
            <TextBlock Text="PU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ActionAccent}" VerticalAlignment="Top" Margin="2,0,0,0" IsVisible="{Binding IsPickup}"/>
          </StackPanel>
          <TextBlock Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding ShowRowCrossed}"/>
        </Grid>
        
        <!-- ROW 1: EPISODE & SCENE -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="EP:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <TextBox Text="{Binding Episode}" Width="50" FontSize="12" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsSoundOnlyRow}" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="SC:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <TextBox Text="{Binding Scene}" Width="50" FontSize="12" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsSoundOnlyRow}" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding ShowRowCrossed}"/>
        </Grid>
        
        <!-- ROW 2: CAMERAS & SOUND -->
        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
          
          <!-- CAM A -->
          <StackPanel Orientation="Vertical" Spacing="0" Margin="0,0,16,4">
            <TextBlock Text="{Binding CamARollNumber}" FontSize="9" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsCamARollChangeMarked}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="CAM A:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <Grid Width="80" Height="18" Background="Transparent">
                
                <!-- Plate Menu -->
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A"/>
                    <MenuItem Header="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A"/>
                    <Separator/>
                    <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                  </ContextMenu>
                </Grid.ContextMenu>
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="6" Width="160">
                      <TextBlock Text="CAM A Roll #" FontWeight="Bold" FontSize="11"/>
                      <TextBox Text="{Binding CamARollNumber}" PlaceholderText="Enter roll number..." AcceptsReturn="True" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                        <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="2,0,0,0"/>
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
                
                <!-- The Editable Text Box -->
                <Panel IsVisible="{Binding ShowCamANormal}" VerticalAlignment="Center">
                  <TextBox Text="{Binding CamARoll}" PlaceholderText="Shot..." FontSize="12" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsCamANotEditable}" AcceptsReturn="True" TextWrapping="Wrap">
                    <!-- Cake Menu -->
                    <TextBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A"/>
                        <MenuItem Header="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A"/>
                        <Separator/>
                        <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                      </ContextMenu>
                    </TextBox.ContextMenu>
                  </TextBox>
                </Panel>
                
                <TextBlock Text="ΑΚΥΡΟ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsCamAVoided}" VerticalAlignment="Center"/>
                <TextBlock Text="XXXXXX" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCamACrossed}"/>
                <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" IsVisible="{Binding IsCamANoRoll}" VerticalAlignment="Center" Height="14"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          
          <!-- CAM B -->
          <StackPanel Orientation="Vertical" Spacing="0" Margin="0,0,16,4">
            <TextBlock Text="{Binding CamBRollNumber}" FontSize="9" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsCamBRollChangeMarked}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="CAM B:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <Grid Width="80" Height="18" Background="Transparent">
                
                <!-- Plate Menu -->
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B"/>
                    <MenuItem Header="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B"/>
                    <Separator/>
                    <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                  </ContextMenu>
                </Grid.ContextMenu>
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="6" Width="160">
                      <TextBlock Text="CAM B Roll #" FontWeight="Bold" FontSize="11"/>
                      <TextBox Text="{Binding CamBRollNumber}" PlaceholderText="Enter roll number..." AcceptsReturn="True" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                        <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="2,0,0,0"/>
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>

                <!-- The Editable Text Box -->
                <Panel IsVisible="{Binding ShowCamBNormal}" VerticalAlignment="Center">
                  <TextBox Text="{Binding CamBRoll}" PlaceholderText="Shot..." FontSize="12" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsCamBNotEditable}" AcceptsReturn="True" TextWrapping="Wrap">
                    <!-- Cake Menu -->
                    <TextBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B"/>
                        <MenuItem Header="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B"/>
                        <Separator/>
                        <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                      </ContextMenu>
                    </TextBox.ContextMenu>
                  </TextBox>
                </Panel>
                
                <TextBlock Text="ΑΚΥΡΟ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsCamBVoided}" VerticalAlignment="Center"/>
                <TextBlock Text="XXXXXX" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCamBCrossed}"/>
                <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" IsVisible="{Binding IsCamBNoRoll}" VerticalAlignment="Center" Height="14"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          
          <!-- EXTRA CAMERAS -->
          <ItemsControl ItemsSource="{Binding ExtraCameraRolls}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraRollCell">
                <StackPanel Orientation="Vertical" Spacing="0" Margin="0,0,16,4">
                  <TextBlock Text="{Binding RollNumber}" FontSize="9" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsRollChangeMarked}"/>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Label, StringFormat={}{0}:}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                    <Grid Width="70" Height="18" Background="Transparent">
                      
                      <!-- Plate Menu -->
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCommand}"/>
                          <MenuItem Header="No Roll" Command="{Binding ToggleNoRollCommand}"/>
                          <Separator/>
                          <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Bottom">
                          <StackPanel Spacing="6" Width="160">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11"/>
                              <TextBlock Text=" Roll #" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBox Text="{Binding RollNumber}" PlaceholderText="Enter roll number..." AcceptsReturn="True" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,*">
                              <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" Click="CloseFlyout_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                              <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Margin="2,0,0,0"/>
                            </Grid>
                          </StackPanel>
                        </Flyout>
                      </FlyoutBase.AttachedFlyout>

                      <!-- The Editable Text Box -->
                      <Panel IsVisible="{Binding ShowNormal}" VerticalAlignment="Center">
                        <TextBox Text="{Binding Roll}" PlaceholderText="Shot..." FontSize="12" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsReadOnly="{Binding IsNotEditable}" AcceptsReturn="True" TextWrapping="Wrap">
                          <!-- Cake Menu -->
                          <TextBox.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCommand}"/>
                              <MenuItem Header="No Roll" Command="{Binding ToggleNoRollCommand}"/>
                              <Separator/>
                              <MenuItem Header="Set / Edit Roll Change..." Click="ChangeRollMenuItem_Click"/>
                            </ContextMenu>
                          </TextBox.ContextMenu>
                        </TextBox>
                      </Panel>
                      
                      <TextBlock Text="ΑΚΥΡΟ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsVoided}" VerticalAlignment="Center"/>
                      <TextBlock Text="XXXXXX" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCrossed}"/>
                      <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" IsVisible="{Binding IsNoRoll}" VerticalAlignment="Center" Height="14"/>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          
          <!-- SOUND -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4">
            <TextBlock Text="SOUND:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            <Grid Width="70" Height="18" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="No Roll" Command="{Binding ToggleSoundNoRollCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Panel IsVisible="{Binding ShowSoundNormal}" VerticalAlignment="Center">
                <TextBox Text="{Binding SoundNotes}" FontSize="12" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource TextPrimary}" IsVisible="{Binding !ShowRowCrossed}" IsReadOnly="{Binding IsSoundNoRoll}" AcceptsReturn="True" TextWrapping="Wrap">
                  <TextBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="No Roll" Command="{Binding ToggleSoundNoRollCommand}"/>
                    </ContextMenu>
                  </TextBox.ContextMenu>
                </TextBox>
              </Panel>
              <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" IsVisible="{Binding IsSoundNoRoll}" VerticalAlignment="Center" Height="14"/>
              <TextBlock Text="XXXX" FontSize="10" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}"/>
            </Grid>
          </StackPanel>
          
        </WrapPanel>
        
        <!-- ROW 3: TAGS -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
            <Button Content="{Binding FalseStartCount, StringFormat=FS x{0}}" FontSize="10" Padding="4,1" IsVisible="{Binding FalseStartCount}" Command="{Binding IncrementFalseStartsCommand}"/>
            <Button Content="+FS" FontSize="10" Padding="4,0" Command="{Binding IncrementFalseStartsCommand}"/>
            <Button Content="-FS" FontSize="10" Padding="4,0" IsVisible="{Binding FalseStartCount}" Command="{Binding DecrementFalseStartsCommand}"/>
            <ToggleButton Content="LS" FontSize="10" Padding="4,0" IsChecked="{Binding IsLongStart}" Command="{Binding ToggleLongStartCommand}"/>
            <ToggleButton Content="BL" FontSize="10" Padding="4,0" IsChecked="{Binding IsBlooper, Mode=TwoWay}">
              <ToggleButton.Styles>
                <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                  <Setter Property="Foreground" Value="#121212"/>
                </Style>
                <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                  <Setter Property="Foreground" Value="#121212"/>
                </Style>
                <Style Selector="ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                  <Setter Property="Foreground" Value="#121212"/>
                  <Setter Property="Opacity" Value="0.8"/>
                </Style>
                <Style Selector="ToggleButton:checked">
                  <Setter Property="FontWeight" Value="Bold"/>
                </Style>
              </ToggleButton.Styles>
            </ToggleButton>
          </StackPanel>
          <TextBlock Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding ShowRowCrossed}"/>
        </Grid>
        
        <!-- ROW 4: NOTES -->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" Background="Transparent">
          <Grid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Toggle Blooper" Command="{Binding ToggleBlooperCommand}"/>
            </ContextMenu>
          </Grid.ContextMenu>
          <Grid Background="Transparent">
            <TextBox Text="{Binding TakeNotes}" PlaceholderText="Notes..." AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" IsVisible="{Binding !ShowRowCrossed}" Margin="0,0,10,0" VerticalContentAlignment="Top"/>
            
            <!-- Vertical Orange Indicator Line at Far Right -->
            <Border Background="{StaticResource BlooperOrange}" HorizontalAlignment="Right" IsVisible="{Binding IsBlooper}" VerticalAlignment="Stretch" Width="4"/>
          </Grid>
          <TextBlock Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding ShowRowCrossed}"/>
        </Grid>
        
      </Grid>
    </Border>
  </Grid>
</UserControl>