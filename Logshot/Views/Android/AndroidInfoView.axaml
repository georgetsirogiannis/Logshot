<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Logshot.Views.Android.AndroidInfoView"
             x:DataType="vm:MainViewModel">

  <Grid Background="{StaticResource WorkspaceBackground}">
    <Grid RowDefinitions="Auto, *" Margin="20">
      <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
        <PathIcon Grid.Column="0" Data="{StaticResource IconSettings}" Foreground="{StaticResource TextSecondary}" Width="20" Height="20" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Button Classes="quiet" Grid.Column="2" Content="✕" Command="{Binding CloseInfoViewCommand}" FontSize="18" Padding="10,8" MinHeight="48" Foreground="{StaticResource TextSecondary}"/>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="18">
          <TextBlock Text="AUTOCORRECTION" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,-10"/>
          <Border Background="{StaticResource CardBackground}" CornerRadius="14" Padding="16,6">
            <StackPanel>
              <Grid ColumnDefinitions="*, Auto" MinHeight="58">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Spelling autocorrect" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock Text="Correct common shorthand typos as you type" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutocorrectEnabled}" OnContent="ON" OffContent="OFF" VerticalAlignment="Center"/>
              </Grid>
              <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"/>
              <Button Classes="quiet" Content="Edit custom dictionary    ›" Command="{Binding OpenCustomDictCommand}" HorizontalContentAlignment="Left" Foreground="{StaticResource ActionAccent}" Padding="0,13" Background="Transparent" MinHeight="48"/>
            </StackPanel>
          </Border>

          <TextBlock Text="DATABASE" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,-10"/>
          <Border Background="{StaticResource CardBackground}" CornerRadius="14" Padding="16,6">
            <StackPanel>
              <Grid ColumnDefinitions="*, Auto" MinHeight="62">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Export scope" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock Text="Choose which production data to transfer" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExportTargets}" SelectedIndex="{Binding SelectedExportTargetIndex}" Width="145" MinHeight="48" VerticalAlignment="Center"/>
              </Grid>
              <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"/>
              <Grid ColumnDefinitions="*, *" MinHeight="56" Margin="-16,0,-16,-6">
                <Button Grid.Column="0" Classes="quiet" Command="{Binding ExportDatabaseCommand}"
                        HorizontalAlignment="Stretch" Foreground="{StaticResource ActionAccent}" Padding="8,13"
                        Background="{StaticResource CardBackground}" BorderThickness="0" CornerRadius="0,0,0,14" MinHeight="52"/>
                <TextBlock Grid.Column="0" Text="Export database" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource ActionAccent}" IsHitTestVisible="False"/>
                <Button Grid.Column="1" Classes="quiet" Command="{Binding ImportDatabaseCommand}"
                        HorizontalAlignment="Stretch" Foreground="{StaticResource ActionAccent}" Padding="8,13"
                        Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" CornerRadius="0,0,14,0" MinHeight="52"/>
                <TextBlock Grid.Column="1" Text="Import database" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource ActionAccent}" IsHitTestVisible="False"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="ACCOUNT" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,-10"/>
          <Border Background="{StaticResource CardBackground}" CornerRadius="14" Padding="16,6">
            <StackPanel>
              <Grid ColumnDefinitions="*, Auto" MinHeight="62">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Cloud sync account" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock Text="{Binding AuthEmail, StringFormat='Signed in as {0}'}" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding IsLoggedIn}" TextWrapping="Wrap"/>
                  <TextBlock Text="Offline (sign in to sync)" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding !IsLoggedIn}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="●" Foreground="{StaticResource ActionAccent}" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsLoggedIn}"/>
              </Grid>
              <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"/>
              <StackPanel Orientation="Horizontal" Spacing="12" MinHeight="54">
                <Button Classes="quiet" Content="Sign in" Command="{Binding OpenLoginCommand}" IsVisible="{Binding !IsLoggedIn}" HorizontalContentAlignment="Left" Foreground="{StaticResource ActionAccent}" Padding="0,13" Background="Transparent" MinHeight="48"/>
                <Button Classes="quiet" Content="Create account" Command="{Binding OpenAccountCreationCommand}" IsVisible="{Binding !IsLoggedIn}" HorizontalContentAlignment="Left" Foreground="{StaticResource ActionAccent}" Padding="0,13" Background="Transparent" MinHeight="48"/>
                <Button Classes="quiet" Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsLoggedIn}" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="0,13" Background="Transparent" MinHeight="48"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource CardBackground}" CornerRadius="14" Padding="16" Margin="0,2,0,0">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock Text="Logshot" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
                <TextBlock Text="v1.0.0" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </StackPanel>
              <TextBlock Text="A daily shot reporting system designed for script supervisors to log, manage, and track film &amp; TV production logs." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="18"/>
              <Separator Background="{StaticResource BorderColor}" Margin="0,3"/>
              <TextBlock Text="© 2026 George Tsirogiannis" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Import DB Confirmation Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsImportConfirmOpen}" ZIndex="500"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="340" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirm Database Merge" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="{Binding ImportWarningMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
          
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
             <Button Classes="quiet" Content="Cancel" Command="{Binding CancelImportCommand}" MinHeight="48" Padding="16,8"/>
            <Button Content="Merge Data" Command="{Binding ConfirmImportCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" FontWeight="Bold" MinHeight="48" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Import Result Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsImportResultOpen}" ZIndex="510"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="340" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ImportResultTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="{Binding ImportResultMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
          
          <Button Content="OK" Command="{Binding CloseImportResultCommand}" 
                  Background="{StaticResource ActionAccent}" Foreground="#121212" MinHeight="48"
                  HorizontalAlignment="Right" FontWeight="Bold" Padding="20,8" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Custom Dictionary Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsCustomDictModalOpen}" ZIndex="520"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="360" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Custom Dictionary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="Add one pair per line (e.g. Κοτνινο = Κοντινό)" 
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
          
          <TextBox Text="{Binding CustomDictText}" 
                   AcceptsReturn="True" 
                   TextWrapping="NoWrap" 
                   MinHeight="140" 
                   MaxHeight="260"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   PlaceholderText="Typo = Correction"/>
          
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
             <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCustomDictCommand}" MinHeight="48" Padding="16,8"/>
            <Button Content="Save Pairs" Command="{Binding SaveCustomDictCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" FontWeight="Bold" MinHeight="48" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>