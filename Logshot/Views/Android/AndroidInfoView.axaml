<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Logshot.Views.Android.AndroidInfoView"
             x:DataType="vm:MainViewModel">

  <Grid Background="{StaticResource WorkspaceBackground}">
    <Grid RowDefinitions="Auto, *" Margin="20">
      
      <!-- Top Header Bar -->
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
        <TextBlock Grid.Column="0" Text="SETTINGS &amp; INFO" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="✕ CLOSE" 
                Command="{Binding CloseInfoViewCommand}"
                VerticalAlignment="Center" Padding="14,8" MinHeight="48" FontWeight="Bold"/>
      </Grid>

      <!-- Settings Body -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="20">
          
          <!-- Autocorrect Block -->
          <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                  BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="SPELLING AUTOCORRECT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutocorrectEnabled}" OnContent="ON" OffContent="OFF"/>
              </Grid>
              
              <TextBlock Text="Instantly corrects common shorthand typos when pressing space."
                         FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="18"/>

              <Button Content="EDIT CUSTOM DICTIONARY" 
                      Command="{Binding OpenCustomDictCommand}"
                      Background="Transparent" BorderBrush="{StaticResource ActionAccent}" BorderThickness="1" Foreground="{StaticResource ActionAccent}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="Bold" MinHeight="48"/>
            </StackPanel>
          </Border>
            
          <!-- Database Export/Import Block -->
          <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                  BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="16">
              <TextBlock Text="DATABASE EXPORT &amp; IMPORT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
              
              <TextBlock Text="Transfer production databases between devices offline."
                         FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="18"/>

              <StackPanel Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="Export Scope:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <ComboBox ItemsSource="{Binding ExportTargets}"
                          SelectedIndex="{Binding SelectedExportTargetIndex}"
                          HorizontalAlignment="Stretch" MinHeight="48"/>
              </StackPanel>

              <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                <Button Grid.Column="0" Content="EXPORT" 
                        Command="{Binding ExportDatabaseCommand}"
                        Background="Transparent" BorderBrush="{StaticResource ActionAccent}" BorderThickness="1" Foreground="{StaticResource ActionAccent}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" FontWeight="Bold" MinHeight="48"/>
                <Button Grid.Column="1" Content="IMPORT" 
                        Command="{Binding ImportDatabaseCommand}"
                        Background="{StaticResource ActionAccent}" Foreground="#121212"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" FontWeight="Bold" MinHeight="48"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- App Details Card -->
          <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                  BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock Text="LOGSHOT" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
                <TextBlock Text="v1.0.0" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </StackPanel>

              <TextBlock Text="A daily shot reporting system designed for script supervisors to log, manage, and track film &amp; TV production logs."
                         FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="18"/>

              <Separator Background="{StaticResource BorderColor}" Margin="0,4"/>

              <TextBlock Text="© 2026 George Tsirogiannis" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Import DB Confirmation Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsImportConfirmOpen}" ZIndex="500"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="340" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirm Database Merge" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="{Binding ImportWarningMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
          
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelImportCommand}" MinHeight="48" Padding="16,8"/>
            <Button Content="Merge Data" Command="{Binding ConfirmImportCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" FontWeight="Bold" MinHeight="48" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Import Result Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsImportResultOpen}" ZIndex="510"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="340" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ImportResultTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="{Binding ImportResultMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
          
          <Button Content="OK" Command="{Binding CloseImportResultCommand}" 
                  Background="{StaticResource ActionAccent}" Foreground="#121212" MinHeight="48"
                  HorizontalAlignment="Right" FontWeight="Bold" Padding="20,8" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Custom Dictionary Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsCustomDictModalOpen}" ZIndex="520"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Width="360" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Custom Dictionary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="Add one pair per line (e.g. Κοτνινο = Κοντινό)" 
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
          
          <TextBox Text="{Binding CustomDictText}" 
                   AcceptsReturn="True" 
                   TextWrapping="NoWrap" 
                   MinHeight="140" 
                   MaxHeight="260"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   PlaceholderText="Typo = Correction"/>
          
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCustomDictCommand}" MinHeight="48" Padding="16,8"/>
            <Button Content="Save Pairs" Command="{Binding SaveCustomDictCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" FontWeight="Bold" MinHeight="48" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>