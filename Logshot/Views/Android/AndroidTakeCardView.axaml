<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             xmlns:views="using:Logshot.Views.Android"
             xmlns:behaviors="using:Logshot.Behaviors"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="Logshot.Views.Android.AndroidTakeCardView"
             x:DataType="vm:TakeViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="IsReadOnly" Value="{Binding $parent[views:AndroidTakeListView].((vm:DayViewModel)DataContext).IsFinalized}" />
      <Setter Property="IsHitTestVisible" Value="{Binding !$parent[views:AndroidTakeListView].((vm:DayViewModel)DataContext).IsFinalized}" />
      <Setter Property="behaviors:AutocorrectBehavior.Enable" Value="True" />
    </Style>
    <Style Selector="Button">
      <Setter Property="IsEnabled" Value="{Binding !$parent[views:AndroidTakeListView].((vm:DayViewModel)DataContext).IsFinalized}" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="IsEnabled" Value="{Binding !$parent[views:AndroidTakeListView].((vm:DayViewModel)DataContext).IsFinalized}" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource CardBackground}" 
          BorderBrush="{StaticResource GridLineColor}" 
          BorderThickness="1" 
          CornerRadius="12"
          Margin="0,0,0,12"
          Padding="16" 
          MinHeight="{Binding RowMinHeight}" 
          IsHitTestVisible="{Binding !$parent[views:AndroidTakeListView].((vm:DayViewModel)DataContext).IsFinalized}">
    
    <Grid>
      <!-- NORMAL LAYOUT (Visible if no camera is voided) -->
      <Grid RowDefinitions="Auto, Auto" IsVisible="{Binding !HasVoidedCameras}">
        
        <!-- HEADER: SHOT, TAKE, EP, SC & MENU -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
          
          <!-- Left: SHOT & TAKE -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Top">
             <!-- SHOT (ΠΛΑΝΟ) -->
             <StackPanel Spacing="4">
                <TextBlock Text="ΠΛΑΝΟ" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBox Text="{Binding DisplayShot}" 
                         TextInputOptions.ContentType="Digits"
                         FontSize="20"
                         FontWeight="Bold" 
                         Width="70" 
                         Height="48" 
                         TextAlignment="Center" 
                         VerticalContentAlignment="Center" 
                         Padding="0"
                         BorderThickness="0"
                         CornerRadius="8"
                         Background="{DynamicResource TextControlBackground}"
                         IsReadOnly="{Binding IsWildOrSoundOnly}"/>
                <Grid Height="20"/>
             </StackPanel>
             
             <!-- TAKE (ΛΗΨΗ) -->
             <StackPanel Spacing="4">
                <TextBlock Text="ΛΗΨΗ" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Grid Width="70" Height="48">
                   <Border Background="{DynamicResource TextControlBackground}" 
                           BorderThickness="0" 
                           CornerRadius="8"/>

                   <!-- Circled Highlight -->
                   <Border Background="Transparent" 
                           BorderBrush="{StaticResource ActionAccent}" 
                           BorderThickness="2.5" 
                           CornerRadius="8" 
                           IsHitTestVisible="False" 
                           IsVisible="{Binding ShowCircledActive}"/>

                   <!-- Take Number Input -->
                   <TextBox Text="{Binding DisplayTakeNumber}" 
                            TextInputOptions.ContentType="Digits"
                            FontSize="20" 
                            FontWeight="Bold" 
                            Foreground="{StaticResource ActionAccent}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            TextAlignment="Center" 
                            VerticalContentAlignment="Center" 
                            Padding="0" 
                            IsReadOnly="{Binding IsWildOrSoundOnly}"/>

                   <!-- Failed Red X Line -->
                   <Path Data="M0,0 L1,1 M1,0 L0,1" 
                         Stretch="Fill" 
                         Stroke="{StaticResource FailRed}" 
                         StrokeThickness="3" 
                         Width="26" 
                         Height="26" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center" 
                         IsHitTestVisible="False" 
                         IsVisible="{Binding ShowFailedActive}"/>
                </Grid>

                <Grid Height="20">
                   <Border Background="{StaticResource HeaderBackground}" 
                           BorderBrush="{StaticResource ActionAccent}" 
                           BorderThickness="1" 
                           CornerRadius="4" 
                           Padding="8,2" 
                           VerticalAlignment="Top" 
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsPickup}">
                      <TextBlock Text="PU" Foreground="{StaticResource ActionAccent}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                   </Border>
                </Grid>
             </StackPanel>
          </StackPanel>

          <!-- Right: EP, SC & Options Menu -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top" Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="ΕΠ" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Text="{Binding Episode}" TextInputOptions.ContentType="Digits" MinWidth="38" Height="36" Padding="0" FontSize="13" TextAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" CornerRadius="6" Background="{DynamicResource TextControlBackground}" IsReadOnly="{Binding IsSoundOnlyRow}"/>
                 </StackPanel>
                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="ΣΚ" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Text="{Binding Scene}" TextInputOptions.ContentType="Digits" MinWidth="38" Height="36" Padding="0" FontSize="13" TextAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" CornerRadius="6" Background="{DynamicResource TextControlBackground}" IsReadOnly="{Binding IsWildOrSoundOnly}"/>
                 </StackPanel>
              </StackPanel>

              <!-- Take Context Menu -->
              <Button Content="⋮" FontSize="24" FontWeight="Bold" Background="Transparent" Padding="8,4" MinHeight="48" MinWidth="48" VerticalAlignment="Center">
                 <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                       <StackPanel Spacing="8" Width="200">
                          <Button Content="Mark Circled" Command="{Binding MarkCircledCommand}" Click="CloseFlyout_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12" MinHeight="48"/>
                          <Button Content="Mark Failed" Command="{Binding MarkFailedCommand}" Click="CloseFlyout_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12" MinHeight="48"/>
                          <Button Content="Toggle Pickup (PU)" Command="{Binding TogglePickupCommand}" Click="CloseFlyout_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12" MinHeight="48"/>
                          <Separator Background="{StaticResource BorderColor}"/>
                          <Button Content="Delete Take" Click="DeleteTake_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="12" MinHeight="48"/>
                       </StackPanel>
                    </Flyout>
                 </Button.Flyout>
              </Button>
          </StackPanel>
        </Grid>

        <!-- MAIN CONTENT (CAMERAS, SOUND, CHIPS & NOTES) -->
        <Grid Grid.Row="1">
           <StackPanel Spacing="14">
              
              <!-- CAM A -->
              <Grid ColumnDefinitions="90, *">
                 <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CamARollNumber}" FontSize="10" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsCamARollChangeMarked}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                       <TextBlock Text="CAM A" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                       <Button Content="⋮" FontSize="16" FontWeight="Bold" Padding="6,2" MinHeight="36" Background="Transparent" VerticalAlignment="Center">
                          <Button.Flyout>
                             <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="200">
                                   <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                   <Button Content="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                   <Separator Background="{StaticResource BorderColor}"/>
                                   <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                   <TextBox Text="{Binding CamARollNumber}" PlaceholderText="Enter roll..."/>
                                   <Grid ColumnDefinitions="*, *">
                                      <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                      <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                   </Grid>
                                </StackPanel>
                             </Flyout>
                          </Button.Flyout>
                       </Button>
                    </StackPanel>
                 </StackPanel>
                 
                 <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="48">
                    <TextBox Text="{Binding CamARoll}" HorizontalAlignment="Stretch" MinHeight="48" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" CornerRadius="8" Background="{DynamicResource TextControlBackground}" IsVisible="{Binding ShowCamANormal}" IsReadOnly="{Binding IsCamANotEditable}" Tag="CAM A" LostFocus="CameraRoll_LostFocus"/>
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsCamAVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                    <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" IsVisible="{Binding IsCamANoRoll}" VerticalAlignment="Center" Height="24"/>
                 </Grid>
              </Grid>

              <!-- CAM B -->
              <Grid ColumnDefinitions="90, *">
                 <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CamBRollNumber}" FontSize="10" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsCamBRollChangeMarked}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                       <TextBlock Text="CAM B" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                       <Button Content="⋮" FontSize="16" FontWeight="Bold" Padding="6,2" MinHeight="36" Background="Transparent" VerticalAlignment="Center">
                          <Button.Flyout>
                             <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="200">
                                   <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                   <Button Content="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                   <Separator Background="{StaticResource BorderColor}"/>
                                   <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                   <TextBox Text="{Binding CamBRollNumber}" PlaceholderText="Enter roll..."/>
                                   <Grid ColumnDefinitions="*, *">
                                      <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                      <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                   </Grid>
                                </StackPanel>
                             </Flyout>
                          </Button.Flyout>
                       </Button>
                    </StackPanel>
                 </StackPanel>
                 
                 <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="48">
                    <TextBox Text="{Binding CamBRoll}" HorizontalAlignment="Stretch" MinHeight="48" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" CornerRadius="8" Background="{DynamicResource TextControlBackground}" IsVisible="{Binding ShowCamBNormal}" IsReadOnly="{Binding IsCamBNotEditable}" Tag="CAM B" LostFocus="CameraRoll_LostFocus"/>
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsCamBVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                    <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" IsVisible="{Binding IsCamBNoRoll}" VerticalAlignment="Center" Height="24"/>
                 </Grid>
              </Grid>

              <!-- EXTRA CAMERAS -->
              <ItemsControl ItemsSource="{Binding ExtraCameraRolls}">
                 <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CameraRollCell">
                       <Grid ColumnDefinitions="90, *" Margin="0,8,0,0">
                          <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                             <TextBlock Text="{Binding RollNumber}" FontSize="10" TextDecorations="Underline" Foreground="{StaticResource ActionAccent}" IsVisible="{Binding IsRollChangeMarked}"/>
                             <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button Content="⋮" FontSize="16" FontWeight="Bold" Padding="6,2" MinHeight="36" Background="Transparent" VerticalAlignment="Center">
                                   <Button.Flyout>
                                      <Flyout Placement="BottomEdgeAlignedLeft">
                                         <StackPanel Spacing="8" Width="200">
                                            <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                            <Button Content="No Roll" Command="{Binding ToggleNoRollCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                            <Separator Background="{StaticResource BorderColor}"/>
                                            <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBox Text="{Binding RollNumber}" PlaceholderText="Enter roll..."/>
                                            <Grid ColumnDefinitions="*, *">
                                               <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                               <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                         </StackPanel>
                                      </Flyout>
                                   </Button.Flyout>
                                </Button>
                             </StackPanel>
                          </StackPanel>
                          
                          <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="48">
                             <TextBox Text="{Binding Roll}" HorizontalAlignment="Stretch" MinHeight="48" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" CornerRadius="8" Background="{DynamicResource TextControlBackground}" IsVisible="{Binding ShowNormal}" IsReadOnly="{Binding IsNotEditable}" LostFocus="CameraRoll_LostFocus"/>
                             <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                             <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" IsVisible="{Binding IsNoRoll}" VerticalAlignment="Center" Height="24"/>
                          </Grid>
                       </Grid>
                    </DataTemplate>
                 </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- SOUND -->
              <Grid ColumnDefinitions="90, *">
                 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="SOUND" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button Content="⋮" FontSize="16" FontWeight="Bold" Padding="6,2" MinHeight="36" Background="Transparent" VerticalAlignment="Center">
                       <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedLeft">
                             <StackPanel Spacing="8" Width="180">
                                <Button Content="No Roll" Command="{Binding ToggleSoundNoRollCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                             </StackPanel>
                          </Flyout>
                       </Button.Flyout>
                    </Button>
                 </StackPanel>
                 
                 <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="48">
                    <TextBox Text="{Binding SoundNotes}" HorizontalAlignment="Stretch" MinHeight="48" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" CornerRadius="8" Background="{DynamicResource TextControlBackground}" IsVisible="{Binding ShowSoundNormal}" IsReadOnly="{Binding IsSoundNoRoll}" LostFocus="SoundRoll_LostFocus"/>
                    <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" IsVisible="{Binding IsSoundNoRoll}" VerticalAlignment="Center" Height="24"/>
                 </Grid>
              </Grid>

              <!-- ACTION CHIPS BAR & TAKE NOTES -->
              <StackPanel Spacing="12" Margin="0,6,0,0">
                 
                 <!-- Touch Action Chips Bar -->
                 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                       
                       <!-- FS Chips -->
                       <Border Background="{StaticResource HeaderBackground}" CornerRadius="8" ClipToBounds="True">
                          <StackPanel Orientation="Horizontal">
                              <Button Content="-FS" Command="{Binding DecrementFalseStartsCommand}" IsVisible="{Binding FalseStartCount}" Padding="14,10" Background="Transparent" FontSize="13" FontWeight="Bold"/>
                              <Button Content="{Binding FalseStartCount, StringFormat=FS x{0}}" IsVisible="{Binding FalseStartCount}" Command="{Binding IncrementFalseStartsCommand}" Padding="14,10" Background="Transparent" Foreground="{StaticResource ActionAccent}" FontWeight="Bold" FontSize="13"/>
                              <Button Content="+FS" Command="{Binding IncrementFalseStartsCommand}" IsVisible="{Binding !FalseStartCount}" Padding="14,10" Background="Transparent" FontWeight="Bold" FontSize="13"/>
                          </StackPanel>
                       </Border>

                       <!-- LS Toggle -->
                       <ToggleButton Content="LS" IsChecked="{Binding IsLongStart, Mode=TwoWay}" Padding="18,10" CornerRadius="8" FontWeight="Bold" FontSize="13">
                          <ToggleButton.Styles>
                             <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                               <Setter Property="Background" Value="{StaticResource LongStartPurple}"/>
                               <Setter Property="Foreground" Value="#121212"/>
                             </Style>
                          </ToggleButton.Styles>
                       </ToggleButton>
                       
                       <!-- BL Toggle -->
                       <ToggleButton Content="BL" IsChecked="{Binding IsBlooper, Mode=TwoWay}" Padding="18,10" CornerRadius="8" FontWeight="Bold" FontSize="13">
                          <ToggleButton.Styles>
                             <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                               <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                               <Setter Property="Foreground" Value="#121212"/>
                             </Style>
                          </ToggleButton.Styles>
                       </ToggleButton>

                       <!-- NB Toggle -->
                       <ToggleButton Content="NB" IsChecked="{Binding IsNoBoard, Mode=TwoWay}" Padding="18,10" CornerRadius="8" FontWeight="Bold" FontSize="13">
                          <ToggleButton.Styles>
                             <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                               <Setter Property="Background" Value="{StaticResource NoBoardTeal}"/>
                               <Setter Property="Foreground" Value="#121212"/>
                             </Style>
                          </ToggleButton.Styles>
                       </ToggleButton>

                       <!-- EB Toggle -->
                       <ToggleButton Content="EB" IsChecked="{Binding IsEndBoard, Mode=TwoWay}" Padding="18,10" CornerRadius="8" FontWeight="Bold" FontSize="13">
                          <ToggleButton.Styles>
                             <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                               <Setter Property="Background" Value="{StaticResource EndBoardAmber}"/>
                               <Setter Property="Foreground" Value="#121212"/>
                             </Style>
                          </ToggleButton.Styles>
                       </ToggleButton>
                    </StackPanel>
                 </ScrollViewer>

                 <!-- Observations / Notes -->
                 <Grid>
                    <TextBox Text="{Binding TakeNotes}" PlaceholderText="Add observations..." HorizontalAlignment="Stretch" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="12" BorderThickness="0" CornerRadius="8" Background="{DynamicResource TextControlBackground}"/>
                    <Border Background="{StaticResource BlooperOrange}" HorizontalAlignment="Right" IsVisible="{Binding IsBlooper}" VerticalAlignment="Stretch" Width="5" CornerRadius="0,8,8,0"/>
                 </Grid>
              </StackPanel>

           </StackPanel>
        </Grid>
      </Grid>

      <!-- VOIDED LAYOUT (Visible if any camera is voided) -->
      <StackPanel IsVisible="{Binding HasVoidedCameras}" VerticalAlignment="Center" Spacing="12" Margin="0,12">
          <TextBlock Text="{Binding VoidedHeadingText, FallbackValue='ΑΚΥΡΟ CLIP'}" 
                     FontSize="18" 
                     FontWeight="Bold" 
                     Foreground="{StaticResource FailRed}"
                     HorizontalAlignment="Center" 
                     TextAlignment="Center"/>
                     
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <!-- CAM A -->
              <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                  <Panel VerticalAlignment="Center" Margin="0,0,6,0">
                      <TextBlock Text="CAM A" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsCamAVoided}"/>
                      <TextBlock Text="CAM A" FontSize="15" FontWeight="Bold" Foreground="White" IsVisible="{Binding !IsCamAVoided}"/>
                  </Panel>
                  <Button Content="⋮" FontSize="18" FontWeight="Bold" Padding="8,4" MinHeight="40" Background="Transparent" VerticalAlignment="Center">
                      <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedLeft">
                              <StackPanel Spacing="8" Width="200">
                                  <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                  <Button Content="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                  <Separator Background="{StaticResource BorderColor}"/>
                                  <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                  <TextBox Text="{Binding CamARollNumber}" PlaceholderText="Enter roll..."/>
                                  <Grid ColumnDefinitions="*, *">
                                      <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                      <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM A" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                  </Grid>
                              </StackPanel>
                          </Flyout>
                      </Button.Flyout>
                  </Button>
              </StackPanel>

              <!-- CAM B -->
              <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                  <Panel VerticalAlignment="Center" Margin="0,0,6,0">
                      <TextBlock Text="CAM B" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsCamBVoided}"/>
                      <TextBlock Text="CAM B" FontSize="15" FontWeight="Bold" Foreground="White" IsVisible="{Binding !IsCamBVoided}"/>
                  </Panel>
                  <Button Content="⋮" FontSize="18" FontWeight="Bold" Padding="8,4" MinHeight="40" Background="Transparent" VerticalAlignment="Center">
                      <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedLeft">
                              <StackPanel Spacing="8" Width="200">
                                  <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                  <Button Content="No Roll" Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                  <Separator Background="{StaticResource BorderColor}"/>
                                  <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                  <TextBox Text="{Binding CamBRollNumber}" PlaceholderText="Enter roll..."/>
                                  <Grid ColumnDefinitions="*, *">
                                      <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                      <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM B" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                  </Grid>
                              </StackPanel>
                          </Flyout>
                      </Button.Flyout>
                  </Button>
              </StackPanel>

              <!-- EXTRA CAMERAS -->
              <ItemsControl ItemsSource="{Binding ExtraCameraRolls}">
                  <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CameraRollCell">
                          <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                              <Panel VerticalAlignment="Center" Margin="0,0,6,0">
                                  <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FailRed}" IsVisible="{Binding IsVoided}"/>
                                  <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="White" IsVisible="{Binding !IsVoided}"/>
                              </Panel>
                              <Button Content="⋮" FontSize="18" FontWeight="Bold" Padding="8,4" MinHeight="40" Background="Transparent" VerticalAlignment="Center">
                                  <Button.Flyout>
                                      <Flyout Placement="BottomEdgeAlignedLeft">
                                          <StackPanel Spacing="8" Width="200">
                                              <Button Content="ΑΚΥΡΟ CLIP" Command="{Binding ToggleVoidCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{StaticResource FailRed}" Padding="10"/>
                                              <Button Content="No Roll" Command="{Binding ToggleNoRollCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10"/>
                                              <Separator Background="{StaticResource BorderColor}"/>
                                              <TextBlock Text="Change Roll #:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                              <TextBox Text="{Binding RollNumber}" PlaceholderText="Enter roll..."/>
                                              <Grid ColumnDefinitions="*, *">
                                                  <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyRollChangeCommand}" Click="CloseFlyout_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                                  <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveRollChangeCommand}" Click="CloseFlyout_Click" Foreground="{StaticResource FailRed}" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                              </Grid>
                                          </StackPanel>
                                      </Flyout>
                                  </Button.Flyout>
                              </Button>
                          </StackPanel>
                      </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
          </WrapPanel>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>