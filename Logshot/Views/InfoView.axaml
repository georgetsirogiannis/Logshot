<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="Logshot.Views.InfoView"
             x:DataType="vm:MainViewModel">

  <Grid>
    <!-- Standard Layout -->
    <Grid RowDefinitions="Auto, *" Margin="30" Background="{StaticResource WorkspaceBackground}">
      
      <!-- Top Header Bar with Close Button -->
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,30">
        <TextBlock Grid.Column="0" Text="INFO &amp; SETTINGS" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="✕ CLOSE" 
                Command="{Binding CloseInfoViewCommand}"
                VerticalAlignment="Center" Padding="12,6" FontWeight="Bold"/>
      </Grid>

      <!-- Info Content Body -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
          
          <!-- Database Export/Import Block -->
          <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                  BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="DATABASE EXPORT &amp; IMPORT" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
              
              <TextBlock Text="Transfer your database between devices without an internet connection."
                         FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>

              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="Export Scope:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <ComboBox ItemsSource="{Binding ExportTargets}"
                          SelectedIndex="{Binding SelectedExportTargetIndex}"
                          HorizontalAlignment="Stretch"/>
              </StackPanel>

              <Grid ColumnDefinitions="*, *" Margin="0,12,0,0">
                <Button Grid.Column="0" Content="EXPORT DATABASE" 
                        Command="{Binding ExportDatabaseCommand}"
                        Background="Transparent" BorderBrush="{StaticResource ActionAccent}" BorderThickness="1" Foreground="{StaticResource ActionAccent}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="IMPORT DATABASE" 
                        Command="{Binding ImportDatabaseCommand}"
                        Background="{StaticResource ActionAccent}" Foreground="#121212"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- App Title & Description Block -->
          <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                  BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBlock Text="LOGSHOT" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
                <TextBlock Text="v1.0.0" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </StackPanel>

              <TextBlock Text="A daily shot reporting application designed for script supervisors to easily log, track, manage and export film &amp; television production logs."
                         FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>

              <Separator Background="{StaticResource BorderColor}" Margin="0,4"/>

              <TextBlock Text="© 2026 George Tsirogiannis" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Import DB Merge Confirmation Modal -->
    <Grid Background="#B2000000" IsVisible="{Binding IsImportConfirmOpen}" ZIndex="500"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"> 
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="400" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirm Database Merge" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
          <TextBlock Text="{Binding ImportWarningMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
          
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelImportCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Merge Data" Command="{Binding ConfirmImportCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" Width="150" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>