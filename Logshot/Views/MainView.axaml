<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Logshot.ViewModels"
             xmlns:views="using:Logshot.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Logshot.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid>
    <!-- Top-level loading bar -->
    <ProgressBar IsIndeterminate="{Binding AppViewModel.IsLoading}" 
                 VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                 Height="4" ZIndex="300" 
                 IsVisible="{Binding AppViewModel.IsLoading}"
                 Foreground="{StaticResource ActionAccent}"/>

    <!-- Main Split Layout -->
    <Grid Name="RootSplitGrid" ColumnDefinitions="280, *" IsVisible="{Binding IsInitialized}">

      <!-- ========================================== -->
      <!-- LEFT SIDEBAR: Project & Day Browser          -->
      <!-- ========================================== -->
      <Border Grid.Column="0"
              Background="{StaticResource HeaderBackground}"
              BorderBrush="{StaticResource BorderColor}"
              BorderThickness="0,0,1,0"
              Padding="20"
              IsVisible="{Binding IsSidebarOpen}">
        
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *, Auto, Auto">

          <!-- App Brand -->
          <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
            <TextBlock Grid.Column="0" Text="LOGSHOT" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource ActionAccent}"/>
            <!-- Mobile-only close button -->
            <Button Grid.Column="1" Content="&#10005;" FontSize="14" Padding="6,2"
                    IsVisible="{Binding IsMobileLayout}"
                    Command="{Binding ToggleSidebarCommand}"/>
          </Grid>

          <!-- Project Selector & Management Buttons -->
          <TextBlock Grid.Row="1" Text="ACTIVE PROJECT" FontSize="12" 
                     Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
          
          <ComboBox Grid.Row="2" 
                    ItemsSource="{Binding AppViewModel.Projects}" 
                    SelectedItem="{Binding AppViewModel.CurrentProject}"
                    HorizontalAlignment="Stretch"
                    DisplayMemberBinding="{Binding Name}"
                    PlaceholderText="Select a Project"
                    Margin="0,0,0,8"/>

          <!-- Project Edit & Delete Buttons -->
          <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,0,0,20">
            <Button Grid.Column="0" Content="EDIT PROJECT" FontSize="11" Padding="4,6" Margin="0,0,3,0"
                    Command="{Binding AppViewModel.OpenEditProjectDialogCommand}"
                    IsEnabled="{Binding AppViewModel.CurrentProject, Converter={x:Static ObjectConverters.IsNotNull}}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="DELETE" FontSize="11" Padding="4,6" Margin="3,0,0,0"
                    Foreground="{StaticResource FailRed}"
                    Command="{Binding AppViewModel.PromptDeleteProjectCommand}"
                    CommandParameter="{Binding AppViewModel.CurrentProject}"
                    IsEnabled="{Binding AppViewModel.CurrentProject, Converter={x:Static ObjectConverters.IsNotNull}}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>

          <!-- Targeted Episode & Scene Search Bar -->
          <TextBlock Grid.Row="4" Text="EP/SC SEARCH (e.g. 1/5)" FontSize="12" 
                     Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
          <Grid Grid.Row="5" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBox Grid.Column="0" Text="{Binding AppViewModel.SearchQuery}" PlaceholderText="e.g. 1/5 or 10.32" 
                     VerticalAlignment="Center"
                     IsEnabled="{Binding AppViewModel.CurrentProject, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Grid.Column="1" Content="✕" Margin="4,0,0,0" 
                    Command="{Binding AppViewModel.ClearSearchCommand}"
                    IsVisible="{Binding AppViewModel.IsSearchActive}"
                    VerticalAlignment="Center"/>
          </Grid>

          <!-- Shoot Days List -->
          <TextBlock Grid.Row="6" Text="SHOOT DAYS" FontSize="12" 
                     Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" 
                     VerticalAlignment="Top"/>
          
          <ListBox Grid.Row="6" 
                   ItemsSource="{Binding AppViewModel.CurrentProject.Days}" 
                   SelectedItem="{Binding AppViewModel.CurrentDay}"
                   Background="Transparent"
                   Margin="0,25,0,0"
                   CornerRadius="4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DayViewModel">
                <Grid ColumnDefinitions="Auto, *">
                  <TextBlock Grid.Column="0" Text="{Binding ShootDayNumber, StringFormat='Day {0}'}" 
                             FontWeight="Bold" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding CalendarDate, StringFormat='{}{0:MMM dd, yyyy}'}" 
                             Foreground="{StaticResource TextSecondary}"/>

                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Edit Day Details..." 
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AppViewModel.OpenEditDayDialogCommand}" 
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="Delete Day" 
                                Foreground="{StaticResource FailRed}"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AppViewModel.PromptDeleteDayCommand}" 
                                CommandParameter="{Binding}"/>
                    </ContextMenu>
                  </Grid.ContextMenu>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Action Buttons -->
          <StackPanel Grid.Row="7" Spacing="10" Margin="0,15,0,0">
            <Button Content="+ NEW PROJECT" 
                    Command="{Binding AppViewModel.OpenCreateProjectDialogCommand}" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            
            <Button Content="+ NEW DAY" 
                    Command="{Binding AppViewModel.CreateDayCommand}" 
                    IsEnabled="{Binding AppViewModel.CurrentProject, Converter={x:Static ObjectConverters.IsNotNull}}" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </StackPanel>

          <!-- Cloud Sync Status & Settings Cog -->
          <Grid Grid.Row="8" Margin="0,20,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" ToolTip.Tip="Cloud Sync Status">
              <TextBlock Text="{Binding SyncIcon}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SyncText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Command="{Binding ToggleInfoViewCommand}"
                    Background="Transparent"
                    Padding="6,4"
                    ToolTip.Tip="Info / Settings">
              <TextBlock Text="⚙" FontSize="16" Foreground="{StaticResource TextSecondary}"/>
            </Button>
          </Grid>

        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- RIGHT SIDE: Main Workspace & Info View     -->
      <!-- ========================================== -->
      <Grid Grid.Column="1" RowDefinitions="Auto, *" Background="{StaticResource WorkspaceBackground}">
        
        <!-- Mobile Top Bar with Persistent Hamburger -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8"
                IsVisible="{Binding IsMobileLayout}">
          <Button Content="&#9776;" FontSize="16" Padding="8,4"
                  Command="{Binding ToggleSidebarCommand}"
                  VerticalAlignment="Center"/>
        </Border>

        <!-- Content Container -->
        <Grid Grid.Row="1">
          
          <!-- Workspace Views (Visible when Info/Settings is closed) -->
          <Grid IsVisible="{Binding IsInfoViewOpen, Converter={x:Static BoolConverters.Not}}">
            
            <!-- State 0: Search Results Active -->
            <Grid RowDefinitions="Auto, *" Margin="30"
                  IsVisible="{Binding AppViewModel.IsSearchActive}">
              
              <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Orientation="Vertical">
                  <TextBlock Text="EPISODE &amp; SCENE SEARCH RESULTS" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock Text="{Binding AppViewModel.SearchQuery, StringFormat='Filtering project for Episode/Scene: {0}'}" 
                             FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="CLEAR SEARCH" 
                        Command="{Binding AppViewModel.ClearSearchCommand}"
                        VerticalAlignment="Center"/>
              </Grid>

              <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="20">
                  <TextBlock Text="No matching takes found across project for this Episode/Scene combination."
                             Foreground="{StaticResource TextSecondary}" FontSize="16"
                             IsVisible="{Binding AppViewModel.HasNoSearchResults}"
                             HorizontalAlignment="Center" Margin="0,40,0,0"/>

                  <ItemsControl ItemsSource="{Binding AppViewModel.SearchResultGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DaySearchResultGroupViewModel">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" CornerRadius="6" Padding="16">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsFinalized}" 
                                           ToolTip.Tip="Day is Finalized (Locked)"/>
                                <TextBlock Text="{Binding DayHeader}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ActionAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="(Finalized - Read Only)" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" IsVisible="{Binding IsFinalized}"/>
                              </StackPanel>
                            </Grid>

                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                    CornerRadius="4" Background="{StaticResource CardBackground}" ClipToBounds="True" Height="340">
                              <views:TakeGridView />
                            </Border>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- State 1: No Day Selected -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="AppViewModel.CurrentDay" Converter="{x:Static ObjectConverters.IsNull}"/>
                  <Binding Path="AppViewModel.IsSearchActive" Converter="{x:Static BoolConverters.Not}"/>
                </MultiBinding>
              </StackPanel.IsVisible>
              <TextBlock Text="Select a shoot day or create a new one to begin." 
                         Foreground="{StaticResource TextSecondary}" FontSize="18" 
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- State 2: Day Selected (The A4 Workspace) -->
            <Grid RowDefinitions="Auto, *" Margin="30">
              <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="AppViewModel.CurrentDay" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="AppViewModel.IsSearchActive" Converter="{x:Static BoolConverters.Not}"/>
                </MultiBinding>
              </Grid.IsVisible>
              
              <!-- Header Metadata -->
              <Grid Grid.Row="0" RowDefinitions="Auto, Auto" Margin="0,0,0,20">
                
                <Grid Grid.Row="0" Margin="0,0,0,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Title -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="24" VerticalAlignment="Center" IsVisible="{Binding AppViewModel.CurrentDay.IsFinalized}"
                               ToolTip.Tip="Day is Finalized (Locked)"/>
                    <TextBlock Text="{Binding AppViewModel.CurrentDay.ShootDayNumber, StringFormat='SHOOT DAY {0}'}" 
                               FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- Desktop Action Buttons (Hidden on Mobile) -->
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                              IsVisible="{Binding !IsMobileLayout}">
                    <Button Content="+ SCENE"
                            Command="{Binding AppViewModel.OpenAddSceneDialogCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>

                    <Button Content="+ SHOT"
                            Command="{Binding AppViewModel.CurrentDay.AddShotCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>

                    <Button Content="+ TAKE"
                            Command="{Binding AppViewModel.CurrentDay.AddTakeCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>

                    <Button Content="FINALIZE DAY"
                            Command="{Binding AppViewModel.CurrentDay.FinalizeDayCommand}"
                            IsVisible="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>

                    <Button Content="REOPEN DAY"
                            Command="{Binding AppViewModel.CurrentDay.UndoFinalizeDayCommand}"
                            IsVisible="{Binding AppViewModel.CurrentDay.IsFinalized}"/>

                    <Button Content="EXPORT PDF"
                            Command="{Binding AppViewModel.ExportDayToPdfCommand}"
                            Background="{StaticResource ActionAccent}"
                            Foreground="#121212"
                            FontWeight="Bold"/>
                  </StackPanel>

                  <!-- Mobile Action Buttons (Visible only on Mobile, sitting on a second row) -->
                  <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*, *" Margin="0,16,0,0"
                        IsVisible="{Binding IsMobileLayout}">
                    
                    <Panel Grid.Column="0" Margin="0,0,5,0">
                      <Button Content="FINALIZE DAY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding AppViewModel.CurrentDay.FinalizeDayCommand}"
                              IsVisible="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>
                      <Button Content="REOPEN DAY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding AppViewModel.CurrentDay.UndoFinalizeDayCommand}"
                              IsVisible="{Binding AppViewModel.CurrentDay.IsFinalized}"/>
                    </Panel>
                    
                    <Button Grid.Column="1" Content="EXPORT PDF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="5,0,0,0"
                            Command="{Binding AppViewModel.ExportDayToPdfCommand}"
                            Background="{StaticResource ActionAccent}"
                            Foreground="#121212"
                            FontWeight="Bold"/>
                  </Grid>

                  <!-- Mobile Action Buttons Row 2: + SCENE, + SHOT, + TAKE -->
                  <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*, *, *" Margin="0,8,0,0"
                        IsVisible="{Binding IsMobileLayout}">
                    <Button Grid.Column="0" Content="+ SCENE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,4,0"
                            Command="{Binding AppViewModel.OpenAddSceneDialogCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>
                    <Button Grid.Column="1" Content="+ SHOT" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="2,0,2,0"
                            Command="{Binding AppViewModel.CurrentDay.AddShotCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>
                    <Button Grid.Column="2" Content="+ TAKE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="4,0,0,0"
                            Command="{Binding AppViewModel.CurrentDay.AddTakeCommand}"
                            IsEnabled="{Binding !AppViewModel.CurrentDay.IsFinalized}"/>
                  </Grid>
                </Grid>

                <!-- General Day Notes Box -->
                <Expander Grid.Row="1" 
                          HorizontalAlignment="Stretch" 
                          IsExpanded="False"
                          Background="{StaticResource CardBackground}" 
                          BorderBrush="{StaticResource BorderColor}" 
                          BorderThickness="1" 
                          CornerRadius="4">
                  <Expander.Header>
                    <TextBlock Text="ΠΑΡΑΤΗΡΗΣΕΙΣ ΗΜΕΡΑΣ" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="{StaticResource ActionAccent}" />
                  </Expander.Header>

                  <TextBox Text="{Binding AppViewModel.CurrentDay.GeneralNotes}" 
                           PlaceholderText="Γενικές σημειώσεις (π.χ. οδηγίες/επεξηγήσεις προς μοντέρ)..." 
                           AcceptsReturn="True" 
                           TextWrapping="Wrap" 
                           MinHeight="60" 
                           MaxHeight="150"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           Background="{StaticResource CardBackground}" 
                           BorderBrush="{StaticResource BorderColor}" 
                           BorderThickness="1" 
                           Padding="12,8" 
                           FontSize="13" 
                           Foreground="{StaticResource TextPrimary}"
                           IsReadOnly="{Binding AppViewModel.CurrentDay.IsFinalized}" />
                </Expander>

              </Grid>

              <!-- Grid Layout (Desktop) -->
              <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                      CornerRadius="4" Background="{StaticResource CardBackground}" ClipToBounds="True"
                      IsVisible="{Binding IsMobileLayout, Converter={x:Static BoolConverters.Not}}">
                <views:TakeGridView DataContext="{Binding AppViewModel.CurrentDay}"/>
              </Border>

              <!-- Card Layout (Mobile) -->
              <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                      CornerRadius="4" Background="{StaticResource CardBackground}" ClipToBounds="True"
                      IsVisible="{Binding IsMobileLayout}">
                <views:MobileTakeListView DataContext="{Binding AppViewModel.CurrentDay}"/>
              </Border>

            </Grid>
          </Grid>

          <!-- Info / Settings View -->
          <views:InfoView IsVisible="{Binding IsInfoViewOpen}"/>

        </Grid>

      </Grid>
      
    </Grid>

    <!-- Modal Dialogs -->
    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsProjectPopupOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="440" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Project Details" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>

          <StackPanel Spacing="4">
            <TextBlock Text="Project Title *" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupProjectTitle}" PlaceholderText="e.g. Ghosts Season 1"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Director" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupDirector}" PlaceholderText="Director name"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="DOP (Director of Photography)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupDop}" PlaceholderText="DOP name"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Production Company" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupProductionCompany}" PlaceholderText="Production house"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Script Supervisor" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupScriptSupervisor}" PlaceholderText="Script supervisor name"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding AppViewModel.CancelProjectDialogCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Save Project" Command="{Binding AppViewModel.SaveProjectDialogCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" Width="130" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsDeleteConfirmationOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="380" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Delete Project?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FailRed}"/>
          <TextBlock Text="Are you sure you want to delete this project? This action cannot be undone and will permanently delete all associated shoot days and takes."
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding AppViewModel.CancelDeleteProjectCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Delete" Command="{Binding AppViewModel.ConfirmDeleteProjectCommand}" Background="{StaticResource FailRed}" Foreground="White" Width="100" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsDayPopupOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="360" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Edit Shoot Day" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>

          <StackPanel Spacing="4">
            <TextBlock Text="Shoot Day Number *" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupShootDayNumber}" PlaceholderText="e.g. 54 or 54B"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Calendar Date" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <DatePicker SelectedDate="{Binding AppViewModel.PopupCalendarDate}" HorizontalAlignment="Stretch"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding AppViewModel.CancelDayDialogCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Save Day" Command="{Binding AppViewModel.SaveDayDialogCommand}" Background="{StaticResource ActionAccent}" Foreground="#121212" Width="120" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsDayDeleteConfirmationOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="380" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Delete Shoot Day?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FailRed}"/>
          <TextBlock Text="Are you sure you want to delete this shoot day? This action cannot be undone and will permanently delete all takes logged for this day."
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding AppViewModel.CancelDeleteDayCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Delete" Command="{Binding AppViewModel.ConfirmDeleteDayCommand}" Background="{StaticResource FailRed}" Foreground="White" Width="100" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsAddScenePopupOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="420" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="New Scene Setup" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>

          <StackPanel Spacing="4">
            <TextBlock Text="Episode (ΕΠ) *" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupNewEpisode}" PlaceholderText="e.g. 1 or 10" AcceptsReturn="True" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Scene (ΣΚ) *" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding AppViewModel.PopupNewScene}" PlaceholderText="e.g. 32 or 28-29" AcceptsReturn="True" TextWrapping="Wrap"/>
          </StackPanel>

          <!-- FIXED ACTION BAR -->
          <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,12,0,0">
            
            <!-- Left Side: Wild Shot (Ghost Button Style) -->
            <!-- Note: Wire up your new Command here when you write it in the ViewModel -->
            <Button Grid.Column="0" Content="+ Wild Shot" 
                    Command="{Binding AppViewModel.ConfirmAddWildShotDialogCommand}"
                    Background="Transparent" BorderBrush="{StaticResource ActionAccent}" BorderThickness="1" Foreground="{StaticResource ActionAccent}"
                    Padding="12,6" HorizontalContentAlignment="Center"/>

            <!-- Right Side: Cancel & Initialize Group -->
            <Button Grid.Column="2" Content="Cancel" 
                    Command="{Binding AppViewModel.CancelAddSceneDialogCommand}" 
                    Margin="0,0,10,0" Padding="16,6" HorizontalContentAlignment="Center"/>
                    
            <Button Grid.Column="3" Content="Initialize Scene" 
                    Command="{Binding AppViewModel.ConfirmAddSceneDialogCommand}" 
                    Background="{StaticResource ActionAccent}" Foreground="#121212" 
                    Padding="16,6" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </Grid>
          
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsTakeDeleteConfirmationOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="380" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Delete Take?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FailRed}"/>
          <TextBlock Text="Are you sure you want to delete this take? This action cannot be undone."
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding AppViewModel.CancelDeleteTakeCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Delete" Command="{Binding AppViewModel.ConfirmDeleteTakeCommand}" Background="{StaticResource FailRed}" Foreground="White" Width="100" HorizontalContentAlignment="Center" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.CurrentDay.IsContinuityPopupOpen, FallbackValue=False}" ZIndex="250"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="440" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="20">
          <StackPanel Spacing="8">
              <TextBlock Text="Continuity History Found" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ActionAccent}"/>
              <TextBlock Text="{Binding AppViewModel.CurrentDay.ContinuityMessage}"
                         TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="15" LineHeight="22"/>
          </StackPanel>
          
          <StackPanel Spacing="12" Margin="0,10,0,0">
            <Button Content="{Binding AppViewModel.CurrentDay.ContinuityOption1Text}" 
                    Command="{Binding AppViewModel.CurrentDay.ConfirmContinuityNewShotCommand}" 
                    Background="{StaticResource ActionAccent}" Foreground="#121212" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                    FontWeight="Bold" FontSize="14" Padding="12"/>
                    
            <Button Content="{Binding AppViewModel.CurrentDay.ContinuityOption2Text}" 
                    Command="{Binding AppViewModel.CurrentDay.ConfirmContinuitySameShotCommand}" 
                    Background="Transparent" BorderBrush="{StaticResource ActionAccent}" BorderThickness="1" Foreground="{StaticResource ActionAccent}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                    FontWeight="Bold" FontSize="13" Padding="10"/>
          </StackPanel>
          
          <Button Content="Cancel" Command="{Binding AppViewModel.CurrentDay.CancelContinuityPromptCommand}" 
                  Background="Transparent" Foreground="{StaticResource TextSecondary}"
                  HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Background="#B2000000" IsVisible="{Binding AppViewModel.IsPdfExportErrorOpen}" ZIndex="200"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="8" Width="380" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Cannot Export PDF" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FailRed}"/>
          <TextBlock Text="Please finalize the day before exporting the PDF. This ensures the End Day marker is properly generated and no further edits are made to the document."
                     TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="22"/>
          <Button Content="Okay" Command="{Binding AppViewModel.ClosePdfExportErrorCommand}" 
                  Background="{StaticResource ActionAccent}" Foreground="#121212" 
                  HorizontalAlignment="Right" HorizontalContentAlignment="Center" Width="100" FontWeight="Bold"/>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>