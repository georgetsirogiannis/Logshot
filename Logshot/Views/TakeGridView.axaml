<UserControl d:DesignHeight="500" d:DesignWidth="1100" mc:Ignorable="d" x:Class="Logshot.Views.TakeGridView" x:DataType="vm:DayViewModel" xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Logshot.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Styles>
    <!-- Standard row border (bottom grey line for every row) -->
    <Style Selector="Border.row-border">
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{StaticResource GridLineColor}"/>
      <Setter Property="IsHitTestVisible" Value="{Binding $parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized, Converter={x:Static BoolConverters.Not}}" />
    </Style>
    <!-- Make all textboxes read-only and non-interactive when finalized -->
    <Style Selector="TextBox">
      <Setter Property="IsReadOnly" Value="{Binding $parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized}" />
      <Setter Property="IsHitTestVisible" Value="{Binding !$parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized}" />
    </Style>
    <!-- Disable buttons when finalized -->
    <Style Selector="Button">
      <Setter Property="IsEnabled" Value="{Binding !$parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized}" />
    </Style>
    <!-- Disable toggle buttons (FS, LS, BL) when finalized -->
    <Style Selector="ToggleButton">
      <Setter Property="IsEnabled" Value="{Binding !$parent[UserControl].((vm:DayViewModel)DataContext).IsFinalized}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ========================================================================= -->
    <!-- SECTION 1: TOP ACTION BAR (Add Extra Camera Input & Button)               -->
    <!-- ========================================================================= -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,10,16,10" Orientation="Horizontal" Spacing="6">
      <TextBox FontSize="11" Name="NewCameraLabelBox" VerticalAlignment="Center" PlaceholderText="e.g. CAM C" Width="80"/>
      <Button Click="AddCamera_Click" Content="+ CAM" FontSize="11" Padding="6,2" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ========================================================================= -->
    <!-- SECTION 2: STICKY TABLE HEADER ROW                                        -->
    <!-- ========================================================================= -->
    <Border Grid.Row="1" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" ZIndex="10">
      <Grid ColumnDefinitions="Auto,10*,10*,Auto,6*,4*,4*,5*,5*,48*" MinHeight="34">
        
        <!-- Drag Handle / Row Delete Column Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="0" Width="60"/>
        
        <!-- CAM A Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="1" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="CAM A" VerticalAlignment="Center"/>
        </Border>
        
        <!-- CAM B Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="2" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="CAM B" VerticalAlignment="Center"/>
        </Border>
        
        <!-- Extra Cameras Headers (Dynamically generated with a Delete "✕" button & confirmation flyout) -->
        <ItemsControl Grid.Column="3" ItemsSource="{Binding ExtraActiveCameras}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Padding="4" Width="90">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Grid.Column="0" HorizontalAlignment="Center" Text="{Binding}" VerticalAlignment="Center"/>
                  <Button Background="Transparent" Content="✕" FontSize="10" Foreground="{StaticResource FailRed}" Grid.Column="1" Padding="4,0" ToolTip.Tip="Remove Camera" VerticalAlignment="Center">
                    <Button.Flyout>
                      <Flyout>
                        <StackPanel Spacing="10">
                          <TextBlock FontSize="12" Text="{Binding StringFormat='Remove {0} from all takes?'}"/>
                          <Button Command="{Binding $parent[UserControl].((vm:DayViewModel)DataContext).RemoveCameraCommand}" CommandParameter="{Binding}" Content="Yes, Remove" Foreground="{StaticResource FailRed}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- SOUND ROLL Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="4" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="SOUND ROLL" VerticalAlignment="Center"/>
        </Border>
        
        <!-- EP (Episode) Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="5" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="ΕΠ" VerticalAlignment="Center"/>
        </Border>
        
        <!-- SC (Scene) Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="6" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="ΣΚ" VerticalAlignment="Center"/>
        </Border>
        
        <!-- SHOT Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="7" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="ΠΛΑΝΟ" VerticalAlignment="Center"/>
        </Border>
        
        <!-- TAKE Header -->
        <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="8" Padding="4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Text="ΛΗΨΗ" VerticalAlignment="Center"/>
        </Border>
        
        <!-- NOTES Header -->
        <Border Grid.Column="9" Padding="12,4,4,4">
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Left" Text="ΠΑΡΑΤΗΡΗΣΕΙΣ" VerticalAlignment="Center"/>
        </Border>
        
      </Grid>
    </Border>

    <!-- ========================================================================= -->
    <!-- SECTION 3: SCROLLABLE TAKES ROWS WORKSPACE                                -->
    <!-- ========================================================================= -->
    <ScrollViewer Grid.Row="2" Name="TakesScrollViewer" VerticalScrollBarVisibility="Visible">
      <StackPanel Orientation="Vertical">

        <!-- TAKES ROWS WORKSPACE -->
        <ItemsControl ItemsSource="{Binding Takes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TakeViewModel">
              <Border Background="{StaticResource CardBackground}" Classes="row-border" PointerMoved="Row_PointerMoved" PointerPressed="Row_PointerPressed" PointerReleased="Row_PointerReleased" Tag="{Binding}">
                <Grid>
                  <!-- Main Row Content Grid -->
                  <Grid ColumnDefinitions="Auto,10*,10*,Auto,6*,4*,4*,5*,5*,48*" MinHeight="{Binding RowMinHeight}">
                    
                    <!-- Row Controls Column (Drag Handle & Delete Button) -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="0" Width="60">
                      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Command="{Binding $parent[UserControl].DataContext.PromptDeleteTakeCommand}" CommandParameter="{Binding}" Content="✕" FontSize="10" Padding="4,0"/>
                      </StackPanel>
                    </Border>

                    <!-- ================================================= -->
                    <!-- CAM A COLUMN                                      -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="1" Padding="4">
                      <Grid RowDefinitions="Auto,*">
                        <TextBlock FontSize="10" Foreground="{StaticResource ActionAccent}" Grid.Row="0" HorizontalAlignment="Center" IsVisible="{Binding IsCamARollChangeMarked}" Text="{Binding CamARollNumber}" TextDecorations="Underline"/>
                        <Grid Background="Transparent" Grid.Row="1" VerticalAlignment="Center">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A" Header="ΑΚΥΡΟ CLIP"/>
                              <MenuItem Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A" Header="No Roll"/>
                              <Separator/>
                              <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Bottom">
                              <StackPanel Spacing="6" Width="160">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="CAM A Roll #"/>
                                <TextBox AcceptsReturn="False" Text="{Binding CamARollNumber}" TextWrapping="NoWrap" PlaceholderText="Enter roll number..."/>
                                <Grid ColumnDefinitions="*,*">
                                  <Button Click="CloseFlyout_Click" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM A" Content="Apply" FontSize="10" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0"/>
                                  <Button Click="CloseFlyout_Click" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM A" Content="Remove" FontSize="10" Foreground="{StaticResource FailRed}" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                              </StackPanel>
                            </Flyout>
                          </FlyoutBase.AttachedFlyout>
                          <Panel IsVisible="{Binding ShowCamANormal}" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowCamARoll}" Text="{Binding CamARoll}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsReadOnly="{Binding IsCamANotEditable}" Text="{Binding CamARoll}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center" PlaceholderText="...">
                              <TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles>
                              <TextBox.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM A" Header="ΑΚΥΡΟ CLIP"/>
                                  <MenuItem Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM A" Header="No Roll"/>
                                  <Separator/>
                                  <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                                </ContextMenu>
                              </TextBox.ContextMenu>
                            </TextBox>
                          </Panel>
                          <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsCamAVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                          <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowCamACrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                          <Path Data="M1,0 L0,1" IsVisible="{Binding IsCamANoRoll}" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" VerticalAlignment="Center" Height="14"/>
                        </Grid>
                      </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- CAM B COLUMN                                      -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="2" Padding="4">
                      <Grid RowDefinitions="Auto,*">
                        <TextBlock FontSize="10" Foreground="{StaticResource ActionAccent}" Grid.Row="0" HorizontalAlignment="Center" IsVisible="{Binding IsCamBRollChangeMarked}" Text="{Binding CamBRollNumber}" TextDecorations="Underline"/>
                        <Grid Background="Transparent" Grid.Row="1" VerticalAlignment="Center">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B" Header="ΑΚΥΡΟ CLIP"/>
                              <MenuItem Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B" Header="No Roll"/>
                              <Separator/>
                              <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Bottom">
                              <StackPanel Spacing="6" Width="160">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="CAM B Roll #"/>
                                <TextBox AcceptsReturn="False" Text="{Binding CamBRollNumber}" TextWrapping="NoWrap" PlaceholderText="Enter roll number..."/>
                                <Grid ColumnDefinitions="*,*">
                                  <Button Click="CloseFlyout_Click" Command="{Binding ApplyRollChangeCommand}" CommandParameter="CAM B" Content="Apply" FontSize="10" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0"/>
                                  <Button Click="CloseFlyout_Click" Command="{Binding RemoveRollChangeCommand}" CommandParameter="CAM B" Content="Remove" FontSize="10" Foreground="{StaticResource FailRed}" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                              </StackPanel>
                            </Flyout>
                          </FlyoutBase.AttachedFlyout>
                          <Panel IsVisible="{Binding ShowCamBNormal}" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowCamBRoll}" Text="{Binding CamBRoll}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsReadOnly="{Binding IsCamBNotEditable}" Text="{Binding CamBRoll}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center" PlaceholderText="...">
                              <TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles>
                              <TextBox.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Command="{Binding ToggleVoidCameraCommand}" CommandParameter="CAM B" Header="ΑΚΥΡΟ CLIP"/>
                                  <MenuItem Command="{Binding ToggleCameraNoRollCommand}" CommandParameter="CAM B" Header="No Roll"/>
                                  <Separator/>
                                  <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                                </ContextMenu>
                              </TextBox.ContextMenu>
                            </TextBox>
                          </Panel>
                          <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsCamBVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                          <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowCamBCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                          <Path Data="M1,0 L0,1" IsVisible="{Binding IsCamBNoRoll}" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" VerticalAlignment="Center" Height="14"/>
                        </Grid>
                      </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- EXTRA CAMERAS COLUMNS                             -->
                    <!-- ================================================= -->
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding ExtraCameraRolls}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CameraRollCell">
                          <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Padding="4" Width="90">
                            <Grid RowDefinitions="Auto,*">
                              <TextBlock FontSize="10" Foreground="{StaticResource ActionAccent}" Grid.Row="0" HorizontalAlignment="Center" IsVisible="{Binding IsRollChangeMarked}" Text="{Binding RollNumber}" TextDecorations="Underline"/>
                              <Grid Background="Transparent" Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Command="{Binding ToggleVoidCommand}" Header="ΑΚΥΡΟ CLIP"/>
                                    <MenuItem Command="{Binding ToggleNoRollCommand}" Header="No Roll"/>
                                    <Separator/>
                                    <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                                  </ContextMenu>
                                </Grid.ContextMenu>
                                <FlyoutBase.AttachedFlyout>
                                  <Flyout Placement="Bottom">
                                    <StackPanel Spacing="6" Width="160">
                                      <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding Label}"/>
                                        <TextBlock FontSize="11" FontWeight="Bold" Text=" Roll #"/>
                                      </StackPanel>
                                      <TextBox AcceptsReturn="False" Text="{Binding RollNumber}" TextWrapping="NoWrap" PlaceholderText="Enter roll number..."/>
                                      <Grid ColumnDefinitions="*,*">
                                        <Button Click="CloseFlyout_Click" Command="{Binding ApplyRollChangeCommand}" Content="Apply" FontSize="10" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Click="CloseFlyout_Click" Command="{Binding RemoveRollChangeCommand}" Content="Remove" FontSize="10" Foreground="{StaticResource FailRed}" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                      </Grid>
                                    </StackPanel>
                                  </Flyout>
                                </FlyoutBase.AttachedFlyout>
                                <Panel IsVisible="{Binding ShowNormal}" VerticalAlignment="Center">
                                  <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowRoll}" Text="{Binding Roll}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                  <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsReadOnly="{Binding IsNotEditable}" Text="{Binding Roll}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center" PlaceholderText="...">
                                    <TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles>
                                    <TextBox.ContextMenu>
                                      <ContextMenu>
                                        <MenuItem Command="{Binding ToggleVoidCommand}" Header="ΑΚΥΡΟ CLIP"/>
                                        <MenuItem Command="{Binding ToggleNoRollCommand}" Header="No Roll"/>
                                        <Separator/>
                                        <MenuItem Click="ChangeRollMenuItem_Click" Header="Set / Edit Roll Change..."/>
                                      </ContextMenu>
                                    </TextBox.ContextMenu>
                                  </TextBox>
                                </Panel>
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource FailRed}" HorizontalAlignment="Center" IsVisible="{Binding IsVoided}" Text="ΑΚΥΡΟ CLIP" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                                <Path Data="M1,0 L0,1" IsVisible="{Binding IsNoRoll}" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" VerticalAlignment="Center" Height="14"/>
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ================================================= -->
                    <!-- SOUND ROLL COLUMN                                 -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="4" Padding="4">
                      <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="No Roll" Command="{Binding ToggleSoundNoRollCommand}"/>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Panel IsVisible="{Binding ShowSoundNormal}" VerticalAlignment="Center">
                          <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsVisible="{Binding !ShowRowCrossed}" IsReadOnly="{Binding IsSoundNoRoll}" Text="{Binding SoundNotes}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center">
                            <TextBox.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="No Roll" Command="{Binding ToggleSoundNoRollCommand}"/>
                              </ContextMenu>
                            </TextBox.ContextMenu>
                          </TextBox>
                        </Panel>
                        <Path Data="M1,0 L0,1" IsVisible="{Binding IsSoundNoRoll}" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2" VerticalAlignment="Center" Height="14"/>
                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    
                    <!-- ================================================= -->
                    <!-- EPISODE COLUMN                                    -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="5" Padding="4">
                      <Grid VerticalAlignment="Center">
                        <Panel IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
                          <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowEpisode}" Text="{Binding DisplayEpisode}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Text="{Binding Episode}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center" IsReadOnly="{Binding IsSoundOnlyRow}"><TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles></TextBox>
                        </Panel>
                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    
                    <!-- ================================================= -->
                    <!-- SCENE COLUMN                                      -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="6" Padding="4">
                      <Grid VerticalAlignment="Center">
                        <Panel IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
                          <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowScene}" Text="{Binding DisplayScene}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Text="{Binding Scene}" TextAlignment="Center" TextWrapping="Wrap" VerticalContentAlignment="Center" IsReadOnly="{Binding IsSoundOnlyRow}"><TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles></TextBox>
                        </Panel>
                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    
                    <!-- ================================================= -->
                    <!-- SHOT COLUMN (ΠΛΑΝΟ)                               -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="7" Padding="4">
                      <Grid VerticalAlignment="Center">
                        <Panel IsVisible="{Binding !ShowRowCrossed}" VerticalAlignment="Center">
                          <TextBlock HorizontalAlignment="Center" IsVisible="{Binding ShowShot}" Text="{Binding DisplayShot}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <TextBox AcceptsReturn="False" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Text="{Binding Shot}" TextAlignment="Center" TextWrapping="NoWrap" VerticalContentAlignment="Center" IsReadOnly="{Binding IsSoundOnlyRow}"><TextBox.Styles><Style Selector="TextBox:not(:focus)"><Setter Property="Opacity" Value="0"/></Style></TextBox.Styles></TextBox>
                        </Panel>
                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- TAKE COLUMN (ΛΗΨΗ)                                -->
                    <!-- ================================================= -->
                    <Border BorderBrush="{StaticResource GridLineColor}" BorderThickness="0,0,1,0" Grid.Column="8" Padding="4">
                      <Grid VerticalAlignment="Center">
                        <Border BorderBrush="{StaticResource ActionAccent}" BorderThickness="2" CornerRadius="13" Height="26" HorizontalAlignment="Center" IsVisible="{Binding ShowCircledActive}" VerticalAlignment="Center" Width="26"/>
                        <TextBox AcceptsReturn="False" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding !ShowRowCrossed}" Name="TakeNumberBox" Text="{Binding DisplayTakeNumber}" TextAlignment="Center" TextWrapping="NoWrap" VerticalContentAlignment="Center" IsReadOnly="{Binding IsSoundOnlyRow}">
                          <TextBox.ContextMenu>
                            <ContextMenu>
                              <MenuItem Command="{Binding MarkCircledCommand}" Header="Mark Circled"/>
                              <MenuItem Command="{Binding MarkFailedCommand}" Header="Mark Failed"/>
                              <MenuItem Command="{Binding TogglePickupCommand}" Header="Toggle Pickup (PU)"/>
                            </ContextMenu>
                          </TextBox.ContextMenu>
                        </TextBox>
                        <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Fill" Stroke="{StaticResource FailRed}" StrokeThickness="2.5" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowFailedActive}"/>
                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="{StaticResource ActionAccent}" HorizontalAlignment="Right" IsVisible="{Binding IsPickup}" Margin="2" Text="PU" VerticalAlignment="Top"/>
                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- NOTES COLUMN (ΠΑΡΑΤΗΡΗΣΕΙΣ)                         -->
                    <!-- ================================================= -->
                    <Border Grid.Column="9" Padding="12,4,4,4" Background="Transparent" VerticalAlignment="Stretch">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Command="{Binding ToggleBlooperCommand}" Header="Toggle Blooper"/>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid Background="Transparent">
                        <StackPanel IsVisible="{Binding !ShowRowCrossed}" Orientation="Vertical" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                            <Button Command="{Binding IncrementFalseStartsCommand}" Content="{Binding FalseStartCount, StringFormat=FS x{0}}" FontSize="10" IsVisible="{Binding FalseStartCount}" Padding="4,1"/>
                            <Button Command="{Binding IncrementFalseStartsCommand}" Content="+" FontSize="10" Padding="4,0"/>
                            <Button Command="{Binding DecrementFalseStartsCommand}" Content="-" FontSize="10" IsVisible="{Binding FalseStartCount}" Padding="4,0"/>
                            <ToggleButton Command="{Binding ToggleLongStartCommand}" Content="LS" FontSize="10" IsChecked="{Binding IsLongStart}" Padding="4,0"/>
                            <ToggleButton Content="BL" FontSize="10" Padding="4,0" IsChecked="{Binding IsBlooper, Mode=TwoWay}">
                              <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                                  <Setter Property="Foreground" Value="#121212"/>
                                </Style>
                                <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                                  <Setter Property="Foreground" Value="#121212"/>
                                </Style>
                                <Style Selector="ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                  <Setter Property="Background" Value="{StaticResource BlooperOrange}"/>
                                  <Setter Property="Foreground" Value="#121212"/>
                                  <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                                <Style Selector="ToggleButton:checked">
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                              </ToggleButton.Styles>
                            </ToggleButton>
                          </StackPanel>
                          <TextBox AcceptsReturn="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Margin="0,0,10,0" Text="{Binding TakeNotes}" TextAlignment="Left" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                        </StackPanel>
                        
                        <!-- Vertical Orange Indicator Line at Far Right -->
                        <Border Background="{StaticResource BlooperOrange}" HorizontalAlignment="Right" IsVisible="{Binding IsBlooper}" VerticalAlignment="Stretch" Width="4"/>

                        <TextBlock FontSize="10" HorizontalAlignment="Center" IsVisible="{Binding ShowRowCrossed}" Opacity="0.6" Text="{x:Static vm:TakeViewModel.CrossStitchPattern}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    
                  </Grid>

                  <!-- Thick White Top Line for New Episode/Scene Groups -->
                  <Rectangle Fill="{StaticResource TextPrimary}" Height="3" IsVisible="{Binding IsGroupStart}" VerticalAlignment="Top"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>