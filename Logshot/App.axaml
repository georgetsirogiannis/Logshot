<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Logshot"
             x:Class="Logshot.App"
             RequestedThemeVariant="Dark">
    <!-- Forced to "Dark" ThemeVariant to match the Dark-Mode-First project vision -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 1. Global Typography -->
        <FontFamily x:Key="RobotoCondensed">avares://Logshot/Assets/Fonts#Roboto Condensed</FontFamily>

        <!-- Vector Icon Geometries -->
        <StreamGeometry x:Key="IconSynced">M19.35 14.04C18.67 10.59 15.64 8 12 8 9.11 8 6.6 9.64 5.35 12.04 2.34 12.36 0 14.91 0 18c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zm-8.64 6.25c-.39.39-1.02.39-1.41 0L7.2 18.2c-.39-.39-.39-1.02 0-1.41.39-.39 1.02-.39 1.41 0L10 18.18l4.48-4.48c.39-.39 1.02-.39 1.41 0 .39.39.39 1.02 0 1.41l-5.18 5.18z</StreamGeometry>
        <StreamGeometry x:Key="IconPending">M7,17h6c0.55,0,1-0.45,1-1v-2.59c0-0.27-0.11-0.52-0.29-0.71L11,10l2.71-2.71C13.89,7.11,14,6.85,14,6.59V4 c0-0.55-0.45-1-1-1H7C6.45,3,6,3.45,6,4v2.59c0,0.27,0.11,0.52,0.29,0.71L9,10l-2.71,2.71C6.11,12.89,6,13.15,6,13.41V16 C6,16.55,6.45,17,7,17z M7,6.59V4.5C7,4.22,7.22,4,7.5,4h5C12.78,4,13,4.22,13,4.5v2.09l-3,3L7,6.59z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M4.47 21h15.06c1.54 0 2.5-1.67 1.73-3L13.73 4.99c-.77-1.33-2.69-1.33-3.46 0L2.74 18c-.77 1.33.19 3 1.73 3zM12 14c-.55 0-1-.45-1-1v-2c0-.55.45-1 1-1s1 .45 1 1v2c0 .55-.45 1-1 1zm1 4h-2v-2h2v2z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M19.5,12c0-0.23-0.01-0.45-0.03-0.68l1.86-1.41c0.4-0.3,0.51-0.86,0.26-1.3l-1.87-3.23c-0.25-0.44-0.79-0.62-1.25-0.42 l-2.15,0.91c-0.37-0.26-0.76-0.49-1.17-0.68l-0.29-2.31C14.8,2.38,14.37,2,13.87,2h-3.73C9.63,2,9.2,2.38,9.14,2.88L8.85,5.19 c-0.41,0.19-0.8,0.42-1.17,0.68L5.53,4.96c-0.46-0.2-1-0.02-1.25,0.42L2.41,8.62c-0.25,0.44-0.14,0.99,0.26,1.3l1.86,1.41 C4.51,11.55,4.5,11.77,4.5,12s0.01,0.45,0.03,0.68l-1.86,1.41c-0.4,0.3-0.51,0.86-0.26,1.3l1.87,3.23c0.25,0.44,0.79,0.62,1.25,0.42 l2.15-0.91c0.37,0.26,0.76,0.49,1.17,0.68l0.29,2.31C9.2,21.62,9.63,22,10.13,22h3.73c0.5,0,0.93-0.38,0.99-0.88l0.29-2.31 c0.41-0.19,0.8-0.42,1.17-0.68l2.15,0.91c0.46,0.2,1,0.02,1.25-0.42l1.87-3.23c0.25,0.44,0.14,0.99-0.26-1.3l-1.86-1.41 C19.49,12.45,19.5,12.23,19.5,12z M12.04,15.5c-1.93,0-3.5-1.57-3.5-3.5s1.57-3.5,3.5-3.5s3.5,1.57,3.5,3.5S13.97,15.5,12.04,15.5z</StreamGeometry>
        <StreamGeometry x:Key="IconLocked">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z</StreamGeometry>
        <StreamGeometry x:Key="IconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 15c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1s1 .45 1 1v4c0 .55-.45 1-1 1zm1-8h-2V7h2v2z</StreamGeometry>

        <!-- 2. Dark Mode Color Palette (Neutral Charcoal & Distinct Warm Spectrum) -->

<!-- Backgrounds (Pure neutral charcoal greys) -->
<SolidColorBrush x:Key="WorkspaceBackground">#0F0F10</SolidColorBrush>
<SolidColorBrush x:Key="CardBackground">#19191C</SolidColorBrush>
<SolidColorBrush x:Key="HeaderBackground">#232327</SolidColorBrush>

<!-- Text Colors (High clarity, crisp whites) -->
<SolidColorBrush x:Key="TextPrimary">#F4F4F5</SolidColorBrush>
<SolidColorBrush x:Key="TextSecondary">#A1A1AA</SolidColorBrush>

<!-- Grid & Borders (Subtle, neutral structure) -->
<SolidColorBrush x:Key="GridLineColor">#27272A</SolidColorBrush>
<SolidColorBrush x:Key="BorderColor">#3F3F46</SolidColorBrush>

<!-- Semantic Colors (Saturated, modern accents) -->
<SolidColorBrush x:Key="FailRed">#EF4444</SolidColorBrush>
<SolidColorBrush x:Key="BlooperOrange">#FC682D</SolidColorBrush>    
<SolidColorBrush x:Key="FalseStartBlue">#0EA5E9</SolidColorBrush>
<SolidColorBrush x:Key="LongStartPurple">#A855F7</SolidColorBrush>
<SolidColorBrush x:Key="NoBoardTeal">#14B8A6</SolidColorBrush>
<SolidColorBrush x:Key="EndBoardAmber">#EAB308</SolidColorBrush>
<SolidColorBrush x:Key="ActionAccent">#38BDF8</SolidColorBrush>
<SolidColorBrush x:Key="LockYellow">#FACC15</SolidColorBrush>

        <!-- Cross-Stitch Pattern Brush for Voided/AKYRO Rows -->
        <DrawingBrush x:Key="CrossStitchPatternBrush" TileMode="Tile" SourceRect="0,0 12,12" DestinationRect="0,0 12,12">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1A000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0 12 12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#55FFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,0" EndPoint="12,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#55FFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="12,0" EndPoint="0,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 3. Apply Global Styles to the App Window -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
            <Setter Property="Background" Value="{StaticResource WorkspaceBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Ensure all core text elements inherit Roboto Condensed automatically and that all buttons and toggle buttons are centered -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Prevent disabled controls from fading or dimming in appearance -->
        <Style Selector="Control:disabled">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- FS Chip Styling (Maintains color when disabled/locked) -->
        <Style Selector="Button.fs-chip">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.fs-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>
        <Style Selector="Button.fs-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>
        <Style Selector="Button.fs-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Application.Styles>
</Application>