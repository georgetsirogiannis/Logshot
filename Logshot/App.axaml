<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Logshot"
             x:Class="Logshot.App"
             RequestedThemeVariant="Dark">
    <!-- Forced to "Dark" ThemeVariant to match the Dark-Mode-First project vision -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 1. Global Typography -->
        <FontFamily x:Key="RobotoCondensed">avares://Logshot/Assets/Fonts#Roboto Condensed</FontFamily>

        <!-- 2. Dark Mode Color Palette (Neutral Charcoal & Distinct Warm Spectrum) -->

<!-- Backgrounds (Pure neutral charcoal greys) -->
<SolidColorBrush x:Key="WorkspaceBackground">#0F0F10</SolidColorBrush>
<SolidColorBrush x:Key="CardBackground">#19191C</SolidColorBrush>
<SolidColorBrush x:Key="HeaderBackground">#232327</SolidColorBrush>

<!-- Text Colors (High clarity, crisp whites) -->
<SolidColorBrush x:Key="TextPrimary">#F4F4F5</SolidColorBrush>
<SolidColorBrush x:Key="TextSecondary">#A1A1AA</SolidColorBrush>

<!-- Grid & Borders (Subtle, neutral structure) -->
<SolidColorBrush x:Key="GridLineColor">#27272A</SolidColorBrush>
<SolidColorBrush x:Key="BorderColor">#3F3F46</SolidColorBrush>

<!-- Semantic Colors (Saturated, modern accents) -->
<SolidColorBrush x:Key="FailRed">#EF4444</SolidColorBrush>
<SolidColorBrush x:Key="BlooperOrange">#FC682D</SolidColorBrush>    
<SolidColorBrush x:Key="FalseStartBlue">#0EA5E9</SolidColorBrush>
<SolidColorBrush x:Key="LongStartPurple">#A855F7</SolidColorBrush>
<SolidColorBrush x:Key="NoBoardTeal">#14B8A6</SolidColorBrush>
<SolidColorBrush x:Key="EndBoardAmber">#EAB308</SolidColorBrush>
<SolidColorBrush x:Key="ActionAccent">#38BDF8</SolidColorBrush>
<SolidColorBrush x:Key="LockYellow">#FACC15</SolidColorBrush>

        <!-- Cross-Stitch Pattern Brush for Voided/AKYRO Rows -->
        <DrawingBrush x:Key="CrossStitchPatternBrush" TileMode="Tile" SourceRect="0,0 12,12" DestinationRect="0,0 12,12">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1A000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0 12 12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#55FFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,0" EndPoint="12,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#55FFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="12,0" EndPoint="0,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 3. Apply Global Styles to the App Window -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
            <Setter Property="Background" Value="{StaticResource WorkspaceBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Ensure all core text elements inherit Roboto Condensed automatically -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>

        <!-- Prevent disabled controls from fading or dimming in appearance -->
        <Style Selector="Control:disabled">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- FS Chip Styling (Maintains color when disabled/locked) -->
        <Style Selector="Button.fs-chip">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.fs-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>
        <Style Selector="Button.fs-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>
        <Style Selector="Button.fs-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FalseStartBlue}" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Application.Styles>
</Application>