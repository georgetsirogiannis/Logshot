<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Logshot"
             x:Class="Logshot.App"
             RequestedThemeVariant="Dark">
    <!-- Forced to "Dark" ThemeVariant to match the Dark-Mode-First project vision -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 1. Global Typography -->
        <FontFamily x:Key="RobotoCondensed">avares://Logshot/Assets/Fonts#Roboto Condensed</FontFamily>

        <!-- 2. Dark Mode Color Palette -->
        <!-- Backgrounds -->
        <SolidColorBrush x:Key="WorkspaceBackground">#121212</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackground">#1E1E1E</SolidColorBrush>
        <SolidColorBrush x:Key="HeaderBackground">#252526</SolidColorBrush>

        <!-- Text Colors -->
        <SolidColorBrush x:Key="TextPrimary">#F5F5F5</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#A0A0A0</SolidColorBrush>

        <!-- Grid & Borders -->
        <SolidColorBrush x:Key="GridLineColor">#333333</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#3F3F46</SolidColorBrush>

        <!-- Semantic Colors -->
        <SolidColorBrush x:Key="FailRed">#F44336</SolidColorBrush>
        <SolidColorBrush x:Key="BlooperOrange">#FF9800</SolidColorBrush>
        <SolidColorBrush x:Key="FalseStartBlue">#2196F3</SolidColorBrush>
        <SolidColorBrush x:Key="LongStartPurple">#9C27B0</SolidColorBrush>
        <SolidColorBrush x:Key="NoBoardTeal">#26A69A</SolidColorBrush>
        <SolidColorBrush x:Key="EndBoardAmber">#FFB300</SolidColorBrush>
        <SolidColorBrush x:Key="ActionAccent">#4FC3F7</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 3. Apply Global Styles to the App Window -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
            <Setter Property="Background" Value="{StaticResource WorkspaceBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Ensure all core text elements inherit Roboto Condensed automatically -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource RobotoCondensed}" />
        </Style>

        <!-- Prevent disabled controls from fading or dimming in appearance -->
        <Style Selector="Control:disabled">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </Application.Styles>
</Application>